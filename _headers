# Cache rules for Netlify and Cloudflare Pages (other hosts: set the same headers in their config).
# Pages are always revalidated, so visitors get a new release on their next visit.
# CSS and JS are referenced with ?v=<version>, so a cached copy is never the wrong one.

/
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

/js/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400
